CREATE TABLE IF NOT EXISTS push_subscriptions (
    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    client_id text NOT NULL,
    endpoint text NOT NULL,
    p256dh text,
    auth text,
    content_encoding text,
    created_at timestamptz NOT NULL DEFAULT now(),
    last_seen timestamptz
);

ALTER TABLE push_subscriptions DROP CONSTRAINT IF EXISTS push_subscriptions_endpoint_key;
DROP INDEX IF EXISTS push_subscriptions_endpoint_key;
CREATE UNIQUE INDEX IF NOT EXISTS ux_push_subscriptions_client_endpoint ON push_subscriptions (client_id, endpoint);

CREATE INDEX IF NOT EXISTS ix_push_subscriptions_client_id ON push_subscriptions (client_id);
CREATE INDEX IF NOT EXISTS ix_push_subscriptions_last_seen ON push_subscriptions (last_seen);
