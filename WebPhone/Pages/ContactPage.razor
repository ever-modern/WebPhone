@page "/contact/{ContactId}"
@using WebPhone.Components
@inherits DisposableComponent

@inject ContactsDispatcher Dispatcher

<PageTitle>@(Manager?.Contact.Name ?? ContactId)</PageTitle>

@if (Manager is not null)
{
    <div class="contact-panel">
        <ContactCard Manager="Manager" />
        <PersistentChatPanel PeerId="@ContactId" />
    </div>
}
else
{
    <div class="webphone-empty"><p>Contact not found.</p></div>
}


