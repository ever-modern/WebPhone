@page "/test-rtc"
@using System.Diagnostics

<button @onclick="RunCheck" disabled="@_isChecking">Check</button>

@if (Success is not null && !_isChecking)
{
    if (Success.IsCompletedSuccessfully)
    {
        <p style="color: green;">Check succeeded!</p>
    }
    else
    {
        <p style="color: red;">Check failed. @Success.Exception?.ToString()</p>
    }
}

@code {
    Task? Success;
    bool _isChecking;
    async Task CheckAsync()
    {
        const string peerId1 = "peer1";
        const string peerId2 = "peer2";

        var (peer1, d1) = await CreateDispatcher(peerId1);
        var (peer2, d2) = await CreateDispatcher(peerId2);

        using var _ = d1;
        using var __ = d2;

        var connection1 = await peer1.ConnectAsync(peerId2);
        var connection2 = peer2.FindReadyConnection(peerId1);

        Assert(connection1 is not null, $"{peerId1} could not connect to {peerId2}");
        Assert(connection2 is not null, $"{peerId2} could not connect to {peerId1}");

        const string messageText = "Hello, Peer!";

        using var channel1 = new RtcConnectionMessageChannel(connection1.Bytes);
        using var channel2 = new RtcConnectionMessageChannel(connection2.Bytes);

        RtcMessage? message = null;

        using var reader = channel2.Received.Subscribe(receivedMessage => message = receivedMessage);
        await channel1.WriteAsync(new(RtcMessageType.Ping, messageText));

        await Task.Delay(100);

        Assert(message?.Payload == messageText, "Message payload does not match");
    }

    void RunCheck()
    {
        Success = null;
        _isChecking = true;
        StateHasChanged();
        CheckAsync().ContinueWith(t => { Success = t; _isChecking = false; StateHasChanged(); });
    }

    void Assert(bool condition, string? message = null)
    {
        if (!condition)
        {
            throw new Exception(message);
        }
    }
}