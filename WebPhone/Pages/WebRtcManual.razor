@page "/webrtc/manual"
@using System.Text
@using System.Text.Json
@using EverModern.Blazor.DirectCommunication
@using EverModern.Events
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject RtcConnector RtcConnector
@inject IJSRuntime JS

<PageTitle>WebRTC Manual</PageTitle>

<div class="webrtc-page">
    <header class="webrtc-header">
        <h1>WebRTC Manual Flow</h1>
        <p>Manual offer/answer exchange for troubleshooting.</p>
    </header>

    <section class="webrtc-card">
        <div class="webrtc-field">
            <label>Connection Id</label>
            <input class="webrtc-input" @bind="connectionId" />
        </div>
        <div class="webrtc-field">
            <label>
                <input type="checkbox" @bind="useLegacyInterop" /> Use legacy `webrtcInterop` flow
            </label>
        </div>
    </section>

    <div class="webrtc-grid">
        <section class="webrtc-card">
            <h2>1) Initiator: Create Offer</h2>
            <button class="webrtc-button" @onclick="CreateOfferAsync">Create offer</button>
            <textarea class="webrtc-textarea" rows="8" @bind="localOffer" readonly></textarea>
        </section>

        <section class="webrtc-card">
            <h2>2) Responder: Accept Offer + Create Answer</h2>
            <textarea class="webrtc-textarea" rows="8" @bind="remoteOffer"></textarea>
            <button class="webrtc-button" @onclick="AcceptOfferAsync">Create answer</button>
            <textarea class="webrtc-textarea" rows="8" @bind="localAnswer" readonly></textarea>
        </section>

        <section class="webrtc-card">
            <h2>3) Initiator: Accept Answer</h2>
            <textarea class="webrtc-textarea" rows="8" @bind="remoteAnswer"></textarea>
            <button class="webrtc-button" @onclick="AcceptAnswerAsync">Apply answer</button>
        </section>
    </div>

    <section class="webrtc-card webrtc-status">
        <h2>Connection State</h2>
        <div>
            <span>Peer: @connectionState</span>
            <span>Data channel: @dataChannelState</span>
        </div>
        <div>
            <span>Audio in/out: @audioInState / @audioOutState</span>
            <span>Video in/out: @videoInState / @videoOutState</span>
        </div>
    </section>

    <section class="webrtc-card">
        <h2>Audio</h2>
        <audio class="webrtc-audio" @ref="remoteAudio" autoplay controls></audio>
        <p>@audioStatusMessage</p>
    </section>

    <section class="webrtc-card">
        <h2>Send a Message</h2>
        <div class="webrtc-field">
            <input class="webrtc-input" @bind="messageToSend" placeholder="Type a message" />
            <button class="webrtc-button" @onclick="SendMessageAsync" disabled="@(!CanSend)">Send</button>
        </div>

        <ul class="webrtc-messages">
            @foreach (var message in receivedMessages)
            {
                <li>@message</li>
            }
        </ul>
    </section>
</div>

@code {
    private readonly JsonSerializerOptions jsonOptions = new() { WriteIndented = true };
    private readonly List<string> receivedMessages = [];

    private string connectionId = "demo";
    private string? localOffer;
    private string? remoteOffer;
    private string? localAnswer;
    private string? remoteAnswer;
    private string? connectionState = "new";
    private string? dataChannelState = "new";
    private string audioInState = "unknown";
    private string audioOutState = "unknown";
    private string videoInState = "unknown";
    private string videoOutState = "unknown";
    private string messageToSend = string.Empty;
    private string? audioStatusMessage = "Audio is managed by RTC connection manager.";
    private bool useLegacyInterop;
    private ElementReference remoteAudio;

    private Task<RtcConnection>? pendingInitiatorConnection;
    private TaskCompletionSource<WebRtcAnswer>? pendingAnswerTcs;

    private RtcConnection? initiatorConnection;
    private RtcConnection? responderConnection;

    private Subscription? initiatorStateSubscription;
    private Subscription? responderStateSubscription;
    private Subscription? initiatorBytesSubscription;
    private Subscription? responderBytesSubscription;
    private CancellationTokenSource? mediaStatePollCts;
    private Task? mediaStatePollTask;
    private RtcConnection? currentConnection;

    private WebRtcInterop? legacyWebRtc;
    private bool legacyInitialized;
    private bool legacyAudioStarted;

    private bool CanSend => dataChannelState == "open";

    protected override void OnInitialized()
    {
        legacyWebRtc = new WebRtcInterop(JS);
        legacyWebRtc.ConnectionStateChanged += HandleLegacyConnectionStateChanged;
        legacyWebRtc.DataChannelStateChanged += HandleLegacyDataChannelStateChanged;
        legacyWebRtc.DataMessageReceived += HandleLegacyDataMessageReceived;
        legacyWebRtc.RemoteStreamAvailable += HandleLegacyRemoteStreamAvailable;
    }

    private async Task CreateOfferAsync()
    {
        if (useLegacyInterop)
        {
            await CleanupNewFlowAsync();
            await EnsureLegacyInitializedAsync();
            await EnsureLegacyAudioAsync();

            await legacyWebRtc!.CreateDataChannelAsync(connectionId, "chat");
            var offer = await legacyWebRtc.CreateOfferAsync(connectionId);
            localOffer = JsonSerializer.Serialize(offer, jsonOptions);
            await InvokeAsync(StateHasChanged);
            return;
        }

        await CleanupLegacyFlowAsync();
        await CleanupInitiatorAsync();

        pendingAnswerTcs = new(TaskCreationOptions.RunContinuationsAsynchronously);
        localOffer = null;
        connectionState = "creating-offer";
        dataChannelState = "connecting";

        pendingInitiatorConnection = RtcConnector.InitiateConnectionAsync(async offer =>
        {
            localOffer = JsonSerializer.Serialize(offer, jsonOptions);
            connectionState = "waiting-for-answer";
            await InvokeAsync(StateHasChanged);

            if (pendingAnswerTcs is null)
                throw new InvalidOperationException("No pending answer task for manual flow.");

            return await pendingAnswerTcs.Task;
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task AcceptOfferAsync()
    {
        var offer = DeserializeOffer(remoteOffer);
        if (offer is null)
            return;

        if (useLegacyInterop)
        {
            await CleanupNewFlowAsync();
            await EnsureLegacyInitializedAsync();
            await EnsureLegacyAudioAsync();

            await legacyWebRtc!.SetRemoteDescriptionAsync(connectionId, offer);
            var answer = await legacyWebRtc.CreateAnswerAsync(connectionId);
            localAnswer = JsonSerializer.Serialize(answer, jsonOptions);
            await InvokeAsync(StateHasChanged);
            return;
        }

        await CleanupLegacyFlowAsync();
        await CleanupResponderAsync();

        var accepted = await RtcConnector.AcceptConnectionAsync(offer);
        responderConnection = accepted.Connection;
        localAnswer = JsonSerializer.Serialize(accepted.Answer, jsonOptions);

        await AttachConnectionAsync(responderConnection, isInitiator: false);
        await EnableAudioAsync(responderConnection);
        await InvokeAsync(StateHasChanged);
    }

    private async Task AcceptAnswerAsync()
    {
        var answer = DeserializeAnswer(remoteAnswer);
        if (answer is null)
            return;

        if (useLegacyInterop)
        {
            await EnsureLegacyInitializedAsync();
            await legacyWebRtc!.SetRemoteDescriptionAsync(connectionId, answer);
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (pendingAnswerTcs is null || pendingInitiatorConnection is null)
            return;

        pendingAnswerTcs.TrySetResult(answer);
        initiatorConnection = await pendingInitiatorConnection;

        await AttachConnectionAsync(initiatorConnection, isInitiator: true);
        await EnableAudioAsync(initiatorConnection);

        pendingAnswerTcs = null;
        pendingInitiatorConnection = null;

        await InvokeAsync(StateHasChanged);
    }

    private async Task AttachConnectionAsync(RtcConnection connection, bool isInitiator)
    {
        var stateSubscription = connection.StateChanged.Subscribe(state =>
        {
            connectionState = state;
            dataChannelState = state is "connected" ? "open" : "connecting";
            _ = InvokeAsync(StateHasChanged);
        });

        var bytesSubscription = await connection.SubscribeBytesAsync(bytes =>
        {
            var message = Encoding.UTF8.GetString(bytes);
            receivedMessages.Add($"Remote: {message}");
            _ = InvokeAsync(StateHasChanged);
        });

        if (isInitiator)
        {
            initiatorStateSubscription?.Dispose();
            initiatorBytesSubscription?.Dispose();
            initiatorStateSubscription = stateSubscription;
            initiatorBytesSubscription = bytesSubscription;
        }
        else
        {
            responderStateSubscription?.Dispose();
            responderBytesSubscription?.Dispose();
            responderStateSubscription = stateSubscription;
            responderBytesSubscription = bytesSubscription;
        }

        currentConnection = connection;
        StartMediaStatePolling(connection);
    }

    private void StartMediaStatePolling(RtcConnection connection)
    {
        mediaStatePollCts?.Cancel();
        mediaStatePollCts?.Dispose();

        mediaStatePollCts = new CancellationTokenSource();
        var ct = mediaStatePollCts.Token;

        mediaStatePollTask = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    var state = await connection.GetMediaExchangeStateAsync();
                    audioInState = state.Audio.Input ? "on" : "off";
                    audioOutState = state.Audio.Output ? "on" : "off";
                    videoInState = state.Video.Input ? "on" : "off";
                    videoOutState = state.Video.Output ? "on" : "off";
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
            }
        }, ct);
    }

    private async Task EnsureLegacyInitializedAsync()
    {
        if (legacyInitialized)
            return;

        await legacyWebRtc!.InitializeAsync(connectionId, [
            new WebRtcIceServer { Urls = ["stun:stun.l.google.com:19302"] }
        ]);

        legacyInitialized = true;
    }

    private async Task EnsureLegacyAudioAsync()
    {
        if (legacyAudioStarted)
            return;

        try
        {
            await legacyWebRtc!.StartLocalStreamAsync(connectionId, new
            {
                audio = new
                {
                    echoCancellation = true,
                    noiseSuppression = true,
                    autoGainControl = true
                },
                video = false
            });
            await legacyWebRtc.AddLocalTracksAsync(connectionId);
            legacyAudioStarted = true;
            audioStatusMessage = "Audio enabled via legacy webrtcInterop.";
        }
        catch (JSException ex)
        {
            audioStatusMessage = ex.Message;
        }
    }

    private async Task EnableAudioAsync(RtcConnection connection)
    {
        await connection.EnableAudioInputAsync();
        await connection.EnableAudioOutputAsync();
        audioStatusMessage = "Audio input/output enabled via rtcConnectionManager.";
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(messageToSend))
            return;

        if (useLegacyInterop)
        {
            if (!legacyInitialized)
                return;

            await legacyWebRtc!.SendMessageAsync(connectionId, messageToSend);
            receivedMessages.Add($"Me: {messageToSend}");
            messageToSend = string.Empty;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var connection = initiatorConnection ?? responderConnection;
        if (connection is null)
            return;

        var payload = Encoding.UTF8.GetBytes(messageToSend);
        await connection.WriteBytesAsync(payload);
        receivedMessages.Add($"Me: {messageToSend}");
        messageToSend = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private void HandleLegacyConnectionStateChanged(object? sender, WebRtcConnectionStateChangedEventArgs args)
    {
        if (!useLegacyInterop || args.ConnectionId != connectionId)
            return;

        connectionState = args.State;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLegacyDataChannelStateChanged(object? sender, WebRtcDataChannelStateChangedEventArgs args)
    {
        if (!useLegacyInterop || args.ConnectionId != connectionId)
            return;

        dataChannelState = args.State;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLegacyDataMessageReceived(object? sender, WebRtcDataMessageEventArgs args)
    {
        if (!useLegacyInterop || args.ConnectionId != connectionId)
            return;

        receivedMessages.Add($"Remote: {args.Message}");
        _ = InvokeAsync(StateHasChanged);
    }

    private async void HandleLegacyRemoteStreamAvailable(object? sender, WebRtcRemoteStreamEventArgs args)
    {
        if (!useLegacyInterop || args.ConnectionId != connectionId)
            return;

        await legacyWebRtc!.AttachRemoteAudioAsync(connectionId, remoteAudio);
    }

    private static WebRtcOffer? DeserializeOffer(string? payload)
    {
        if (string.IsNullOrWhiteSpace(payload))
            return null;

        return JsonSerializer.Deserialize<WebRtcOffer>(payload);
    }

    private static WebRtcAnswer? DeserializeAnswer(string? payload)
    {
        if (string.IsNullOrWhiteSpace(payload))
            return null;

        return JsonSerializer.Deserialize<WebRtcAnswer>(payload);
    }

    private async Task StopMediaPollingAsync()
    {
        mediaStatePollCts?.Cancel();

        if (mediaStatePollTask is not null)
            await mediaStatePollTask.ConfigureAwait(ConfigureAwaitOptions.SuppressThrowing);

        mediaStatePollTask = null;
        mediaStatePollCts?.Dispose();
        mediaStatePollCts = null;
    }

    private async Task CleanupInitiatorAsync()
    {
        var disposingConnection = initiatorConnection;

        initiatorStateSubscription?.Dispose();
        initiatorBytesSubscription?.Dispose();
        initiatorStateSubscription = null;
        initiatorBytesSubscription = null;

        if (disposingConnection is not null)
        {
            await disposingConnection.DisposeAsync();
            initiatorConnection = null;
        }

        if (ReferenceEquals(currentConnection, disposingConnection))
        {
            await StopMediaPollingAsync();
            currentConnection = null;
        }
    }

    private async Task CleanupResponderAsync()
    {
        var disposingConnection = responderConnection;

        responderStateSubscription?.Dispose();
        responderBytesSubscription?.Dispose();
        responderStateSubscription = null;
        responderBytesSubscription = null;

        if (disposingConnection is not null)
        {
            await disposingConnection.DisposeAsync();
            responderConnection = null;
        }

        if (ReferenceEquals(currentConnection, disposingConnection))
        {
            await StopMediaPollingAsync();
            currentConnection = null;
        }
    }

    private async Task CleanupNewFlowAsync()
    {
        pendingAnswerTcs?.TrySetCanceled();
        pendingAnswerTcs = null;
        pendingInitiatorConnection = null;

        await CleanupInitiatorAsync();
        await CleanupResponderAsync();
    }

    private async Task CleanupLegacyFlowAsync()
    {
        if (!legacyInitialized)
            return;

        await legacyWebRtc!.CloseAsync(connectionId);
        legacyInitialized = false;
        legacyAudioStarted = false;

        audioInState = "n/a";
        audioOutState = "n/a";
        videoInState = "n/a";
        videoOutState = "n/a";
    }

    public async ValueTask DisposeAsync()
    {
        pendingAnswerTcs?.TrySetCanceled();

        await CleanupNewFlowAsync();
        await CleanupLegacyFlowAsync();

        if (legacyWebRtc is not null)
        {
            legacyWebRtc.ConnectionStateChanged -= HandleLegacyConnectionStateChanged;
            legacyWebRtc.DataChannelStateChanged -= HandleLegacyDataChannelStateChanged;
            legacyWebRtc.DataMessageReceived -= HandleLegacyDataMessageReceived;
            legacyWebRtc.RemoteStreamAvailable -= HandleLegacyRemoteStreamAvailable;
            await legacyWebRtc.DisposeAsync();
        }
    }
}
