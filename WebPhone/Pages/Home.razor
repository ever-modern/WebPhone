@page "/"
@using WebPhone.Services
@inherits DisposableComponent

@inject IProfile Profile
@inject ContactsRepository ContactsRepository
@inject NicknamesRepository NicknamesRepository
@inject Phone Phone

<PageTitle>Web Phone</PageTitle>

<div class="webrtc-page">
    @*  <header class="webrtc-header">
        <h1>WebRTC Demo</h1>
        <p>Enter your name to announce your presence. Select a user to connect.</p>
    </header> *@

    <button class="webrtc-button" @onclick="HandleNotifySelfAsync">Notify self</button>

    <div class="webrtc-shell">
        <main class="webrtc-main">
            <ProfileSettingsCard />

            @if (Profile.User.Name.Length > 0)
            {
                <ContactCardsGrid Cards="_contactCards" />
            }
        </main>
    </div>

@code {
    private readonly Dictionary<string, ContactVm> _vmMap = [];
    private readonly Dictionary<string, IDisposable> _vmSubscriptions = [];
    private IReadOnlyList<ContactCardModel> _contactCards = [];

    protected override void OnInitialized()
    {
        BoundToLifetime(Profile.UserChanged.Subscribe(HandleUserChanged));
        BoundToLifetime(ContactsRepository.StateChanged.Subscribe(HandleServiceStateChanged));
        BoundToLifetime(NicknamesRepository.StateChanged.Subscribe(HandleServiceStateChanged));
        BoundToLifetime(Phone.StateChanged.Subscribe(HandlePhoneStateChanged));
        SyncContactVms();
    }

    private void SyncContactVms()
    {
        var current = ContactsRepository.Contacts;

        foreach (var id in _vmMap.Keys.Except(current.Select(c => c.Id)).ToList())
        {
            _vmMap.Remove(id, out var stale);
            _ = stale!.DisposeAsync().AsTask();

            if (_vmSubscriptions.Remove(id, out var sub))
                sub.Dispose();
        }

        foreach (var contact in current)
        {
            if (_vmMap.TryGetValue(contact.Id, out var existing))
                existing.UpdateContact(contact);
            else
            {
                var vm = new ContactVm(contact, Phone);
                _vmMap[contact.Id] = vm;
                _vmSubscriptions[contact.Id] = vm.Changed.Subscribe(HandleVmChanged);
            }
        }

        _contactCards = current
            .Select(c => BuildCardModel(_vmMap[c.Id]))
            .OrderByDescending(c => c.Contact.IsFavorite)
            .ThenBy(c => c.Contact.Name)
            .ToList();
    }

    private ContactCardModel BuildCardModel(ContactVm vm)
    {
        Action? connect = vm.CanConnect() && !vm.Contact.IsFavorite ? () => _ = vm.ConnectAsync() : null;
        Action? cancelConnect = vm.IsConnecting() && !vm.Contact.IsFavorite ? () => _ = vm.CancelConnectAsync() : null;
        Action? disconnect = vm.IsConnected() && !vm.Contact.IsFavorite ? () => _ = vm.DisconnectAsync() : null;
        Action? acceptCall = vm.IsConnected() && vm.HasIncomingCallOffer && !vm.IsCallActive ? () => _ = vm.AcceptIncomingCallAsync() : null;
        Action? startCall = vm.IsConnected() && !vm.HasIncomingCallOffer && !vm.IsCallActive ? () => _ = vm.StartCallAsync() : null;
        Action? endCall = vm.IsConnected() && vm.IsCallActive ? () => _ = vm.EndCallAsync() : null;
        Action? cancelCall = vm.IsConnected() && !vm.IsCallActive ? () => _ = vm.CancelCallAsync() : null;

        var connectionStatusText = vm.ConnectionState switch
        {
            RtcConnectionState.Connected => "Connected",
            RtcConnectionState.Connecting => "Connecting...",
            RtcConnectionState.Disconnected => "Disconnected",
            RtcConnectionState.Failed => "Connection failed",
            RtcConnectionState.New => "Ready to connect",
            RtcConnectionState.Closed => "Offline",
            _ => vm.ConnectionStateText
        };

        var connectionStatusCssClass = vm.ConnectionState switch
        {
            RtcConnectionState.Connected => "is-connected",
            RtcConnectionState.Connecting => "is-connecting",
            RtcConnectionState.Failed => "is-failed",
            _ => string.Empty
        };

        return new ContactCardModel(
            Contact: vm.Contact,
            Nickname: NicknamesRepository.GetNickname(vm.Contact.Id),
            ConnectionStatusText: connectionStatusText,
            ConnectionStatusCssClass: connectionStatusCssClass,
            IsConnecting: vm.IsConnecting(),
            ChatReady: vm.ChatReady,
            IsChatOpen: vm.IsConnected(),
            IsCallActive: vm.IsCallActive,
            ChatMessages: vm.ChatMessages,
            ToggleFavorite: () => _ = HandleToggleFavoriteAsync(vm.Contact),
            SetNickname: nickname => _ = HandleSetNicknameAsync((vm.Contact.Id, nickname)),
            Notify: () => _ = vm.NotifyPeerAsync(),
            Connect: connect,
            CancelConnect: cancelConnect,
            Disconnect: disconnect,
            StartCall: startCall,
            AcceptCall: acceptCall,
            EndCall: endCall,
            CancelCall: cancelCall,
            SendMessage: vm.ChatReady && vm.IsConnected() ? text => _ = vm.SendChatMessageAsync(text) : null,
            OnRemoteAudioElementReady: audioElement => _ = vm.SetRemoteAudioElementAsync(audioElement)
        );
    }

    private async void HandleVmChanged()
    {
        SyncContactVms();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleUserChanged(User _)
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleServiceStateChanged()
    {
        SyncContactVms();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandlePhoneStateChanged()
    {
        foreach (var vm in _vmMap.Values)
            vm.UpdateConnectionState(Phone.GetConnectionState(vm.Contact.Id));
        SyncContactVms();
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleToggleFavoriteAsync(Contact contact)
        => ContactsRepository.ToggleFavoriteAsync(contact.Id, contact.Name);

    private Task HandleSetNicknameAsync((string UserId, string? Nickname) args)
        => NicknamesRepository.SetNicknameAsync(args.UserId, args.Nickname);

    private Task HandleNotifySelfAsync()
        => Phone.NotifySelfAsync("Self test notification");

    public override async ValueTask DisposeAsync()
    {
        base.Dispose();

        foreach (var vm in _vmMap.Values)
            await vm.DisposeAsync();

        foreach (var sub in _vmSubscriptions.Values)
            sub.Dispose();

        _vmMap.Clear();
        _vmSubscriptions.Clear();
    }
}
</div>
