@page "/"
@inherits DisposableComponent

@inject IProfile Profile

<PageTitle>Web Phone</PageTitle>

@if (Profile.User.Name.Length > 0)
{
    <div class="webphone-empty">
        <p>Select a contact to start chatting</p>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        BoundToLifetime(Profile.UserChanged.Subscribe(_ => InvokeAsync(StateHasChanged)));
    }
}