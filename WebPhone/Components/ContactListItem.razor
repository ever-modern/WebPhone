@using WebPhone.Services

<button class="contact-list-item @(IsSelected ? "contact-list-item--selected" : string.Empty) @StatusClass"
        @onclick="() => OnSelect.InvokeAsync()">
    <span class="contact-list-avatar">@Initials</span>
    <span class="contact-list-info">
        <span class="contact-list-name">@DisplayName</span>
        @if (Status is not null)
        {
            <span class="contact-list-status">
                @if (Card.InteractionState.IsConnecting)
                {
                    <span>@Status<span class="webrtc-dots-animation"></span></span>
                }
                else
                {
                    @Status
                }
            </span>
        }
    </span>
    @if (Card.InteractionState.HasIncomingCall)
    {
        <span class="contact-list-badge contact-list-badge--call" title="Incoming call">📞</span>
    }
    else if (Card.InteractionState.IsCalling)
    {
        <span class="contact-list-badge" title="Calling">📱</span>
    }
    @if (Card.Actions.ToggleFavorite is not null)
    {
        <button class="contact-list-fav @(Card.Contact.IsFavorite ? "contact-list-fav--active" : string.Empty)"
                @onclick="ToggleFavorite"
                @onclick:stopPropagation="true"
                title="@(Card.Contact.IsFavorite ? "Remove favourite" : "Add favourite")">★</button>
    }
</button>

@code {
    [Parameter, EditorRequired] public ContactCardModel Card { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }

    string Initials
    {
        get
        {
            var src = string.IsNullOrWhiteSpace(Card.Contact.Nickname)
                ? Card.Contact.Name
                : Card.Contact.Nickname;
            return src.Length > 0 ? src[0].ToString().ToUpperInvariant() : "?";
        }
    }

    string DisplayName => string.IsNullOrWhiteSpace(Card.Contact.Nickname)
        ? Card.Contact.Name
        : Card.Contact.Nickname;

    string? Status => Card.InteractionState.ConnectionState is "None" or ""
        ? null
        : Card.InteractionState.ConnectionState;

    string StatusClass => Card.InteractionState switch {
        { HasIncomingCall: true }             => "contact-list-item--incoming",
        { IsCallActive: true }                => "contact-list-item--in-call",
        { IsCalling: true }                   => "contact-list-item--calling",
        { IsConnected: true }                 => "contact-list-item--online",
        { IsConnecting: true }                => "contact-list-item--connecting",
        _                                     => string.Empty
    };

    void ToggleFavorite() => Card.Actions.ToggleFavorite?.Invoke();
}
