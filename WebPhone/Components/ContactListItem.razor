<button class="contact-list-item @(IsSelected ? "contact-list-item--selected" : string.Empty) @StatusClass"
        @onclick="() => OnSelect.InvokeAsync()">
    <span class="contact-list-avatar">@Initials</span>
    <span class="contact-list-info">
        <span class="contact-list-name">@DisplayName</span>
        @if (Status is not null)
        {
            <span class="contact-list-status">
                @if (Manager.Interaction is InteractionState.Connecting)
                {
                    <span>@Status<span class="webrtc-dots-animation"></span></span>
                }
                else
                {
                    @Status
                }
            </span>
        }
    </span>
    @if (Manager.Interaction is InteractionState.ReceivingCall)
    {
        <span class="contact-list-badge contact-list-badge--call" title="Incoming call">📞</span>
    }
    else if (Manager.Interaction is InteractionState.Calling)
    {
        <span class="contact-list-badge" title="Calling">📱</span>
    }
    @if (Manager.ToggleFavorite is not null)
    {
        <button class="contact-list-fav @(Manager.Contact.IsFavorite ? "contact-list-fav--active" : string.Empty)"
                @onclick="ToggleFavorite"
                @onclick:stopPropagation="true"
                title="@(Manager.Contact.IsFavorite ? "Remove favourite" : "Add favourite")">★</button>
    }
</button>

@code {
    [Parameter, EditorRequired] public ContactManager Manager { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }

    string Initials
    {
        get
        {
            var src = string.IsNullOrWhiteSpace(Manager.Contact.Nickname)
                ? Manager.Contact.Name
                : Manager.Contact.Nickname;
            return src.Length > 0 ? src[0].ToString().ToUpperInvariant() : "?";
        }
    }

    string DisplayName => string.IsNullOrWhiteSpace(Manager.Contact.Nickname)
        ? Manager.Contact.Name
        : Manager.Contact.Nickname;

    string? Status => Manager.Interaction switch
    {
        InteractionState.Offline or InteractionState.Disconnected => null,
        InteractionState.Connecting => "Connecting",
        InteractionState.Calling => "Calling",
        InteractionState.ReceivingCall => "Incoming call",
        InteractionState.OnCall => "On call",
        InteractionState.Connected => "Connected",
        _ => null
    };

    string StatusClass => Manager.Interaction switch {
        InteractionState.ReceivingCall => "contact-list-item--incoming",
        InteractionState.OnCall        => "contact-list-item--in-call",
        InteractionState.Calling       => "contact-list-item--calling",
        InteractionState.Connected     => "contact-list-item--online",
        InteractionState.Connecting    => "contact-list-item--connecting",
        _                              => string.Empty
    };

    void ToggleFavorite() => Manager.ToggleFavorite?.Invoke();
}
