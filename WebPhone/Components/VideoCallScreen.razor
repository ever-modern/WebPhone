@using WebPhone.Services
@implements IAsyncDisposable

@inject VideoCallState VideoCallState
@inject PeerConnectionsDispatcher PeerConnectionsDispatcher
@inject ContactsDispatcher Dispatcher

@if (VideoCallState.IsOpen)
{
    <div class="video-call-screen">
        <video class="video-call-remote" autoplay playsinline muted @ref="_remoteVideo"></video>
        <video class="video-call-local" autoplay playsinline muted @ref="_localVideo"></video>
        <div class="video-call-overlay">
            <button class="video-call-hangup webrtc-button webrtc-button--danger"
                    @onclick="HangUpAsync">
                &#128222; Hang up
            </button>
        </div>
    </div>
}

@code {
    ElementReference _remoteVideo;
    ElementReference _localVideo;
    bool _targetConnected;

    protected override void OnInitialized() =>
        VideoCallState.Changed += OnStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (VideoCallState.IsOpen && !_targetConnected)
        {
            Console.WriteLine($"[VIDEO] VideoCallScreen.OnAfterRender: IsOpen=true, _targetConnected=false → calling ConnectTargetAsync for contact={VideoCallState.ContactId}");
            if (await ConnectTargetAsync())
                _targetConnected = true;
            else
                Console.WriteLine("[VIDEO] VideoCallScreen.OnAfterRender: ConnectTargetAsync returned false — will retry on next render");
        }
        else if (!VideoCallState.IsOpen)
        {
            _targetConnected = false;
        }
    }

    async Task<bool> ConnectTargetAsync()
    {
        var contactId = VideoCallState.ContactId;
        if (contactId is null)
            return false;
        var connections = PeerConnectionsDispatcher.CurrentConnectionProcesses;
        Console.WriteLine($"[VIDEO] ConnectTargetAsync: contactId={contactId} connections.Count={connections.Count} keys=[{string.Join(",", connections.Keys)}]");
        var conn = await PeerConnectionsDispatcher.ConnectAsync(contactId);
        if (conn is null)
            return false;
        Console.WriteLine("[VIDEO] ConnectTargetAsync: found connection → calling SetVideoTargetAsync");
        await conn.SetVideoTargetAsync(_remoteVideo);
        await conn.SetLocalVideoTargetAsync(_localVideo);
        Console.WriteLine("[VIDEO] ConnectTargetAsync: SetVideoTargetAsync completed");
        return true;
    }

    async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    async Task HangUpAsync()
    {
        // EndCall stops the call on both sides (cancels pings → remote side detects and hangs up too),
        // disables audio+video media, and closes the video screen via VideoCallState.
        var contactId = VideoCallState.ContactId;
        var state = contactId is not null
            ? Dispatcher.State.Contacts.FirstOrDefault(c => c.Contact.Id == contactId)
            : null;
        state?.AvailableActions.EndCall?.Invoke();

        // Fallback close in case EndCall wasn't available (e.g. state already reset)
        VideoCallState.Close();
    }

    public async ValueTask DisposeAsync()
    {
        VideoCallState.Changed -= OnStateChanged;
        await Task.CompletedTask;
    }
}

