@using WebPhone.Services

@implements IDisposable

<section class="webrtc-contacts-card">
    <h2>Contacts</h2>
    @if (!string.IsNullOrWhiteSpace(Phone.SignalingStatus))
    {
        <p>@Phone.SignalingStatus</p>
    }
    <div class="webrtc-contact-carousel">
        @foreach (var user in Phone.Users)
        {
            <ContactCard Phone="Phone"
                         User="user"
                         ConnectionState="@(user.ConnectionState.ToString())" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public Phon Phone { get; set; } = default!;
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            Phone.StateChanged += StateHasChanged;
        }
    }

    public void Dispose()
    {
        Phone.StateChanged -= StateHasChanged;
    }
}
