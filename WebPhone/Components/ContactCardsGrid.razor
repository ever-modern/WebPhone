@using WebPhone.Services

<section class="webrtc-contacts-card">
    <div class="webrtc-field">
        <h2>Contacts</h2>
    </div>

    <div class="webrtc-contact-carousel">
        @foreach (var vm in ContactVms)
        {
            <ContactCard @key="vm.Contact.Id"
                         Vm="vm"
                         Nickname="@GetNickname(vm.Contact.Id)"
                         ToggleFavourite="() => OnToggleFavorite.InvokeAsync(vm.Contact)"
                         OnSetNickname="OnSetNickname" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ContactVm> ContactVms { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<string, string?> GetNickname { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<Contact> OnToggleFavorite { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<(string UserId, string? Nickname)> OnSetNickname { get; set; }
}
