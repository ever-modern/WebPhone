@using WebPhone.Services

<section class="webrtc-contacts-card">
    <div class="webrtc-field">
        <h2>Contacts</h2>
    </div>

    <div class="webrtc-contact-carousel">
        @foreach (var card in Cards)
        {
            <ContactCard @key="card.Contact.Id"
                         Model="card" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ContactCardModel> Cards { get; set; } = [];
}
