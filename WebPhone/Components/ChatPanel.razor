@using WebPhone.Services

<details class="webrtc-chat" open="@IsOpen">
    <summary>Chat</summary>
    <div class="webrtc-chat-compose">
        <input class="webrtc-chat-input" @bind="_text" @bind:event="oninput" @onkeydown="HandleKeyDownAsync" placeholder="Type a message..." disabled="@(!IsEnabled)" />
        <button class="webrtc-send-btn" @onclick="HandleSendAsync" disabled="@(!CanSend)" title="Send">&#10148;</button>
    </div>
    <ul class="webrtc-messages">
        @foreach (var message in Messages)
        {
            <li class="webrtc-message-bubble @(message.IsOwn ? "is-own" : "is-peer")">@message.Text</li>
        }
    </ul>
</details>

@code {
    [Parameter]
    public Action<string>? OnSend { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<ChatMessage> Messages { get; set; } = [];

    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    private string _text = string.Empty;
    private bool CanSend => IsEnabled && OnSend is not null;

    private async Task HandleSendAsync()
    {
        if (!CanSend || string.IsNullOrWhiteSpace(_text)) return;

        var text = _text;
        _text = string.Empty;
        OnSend?.Invoke(text);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await HandleSendAsync();
    }
}
