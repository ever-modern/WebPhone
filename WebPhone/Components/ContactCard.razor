@using WebPhone.Services

@inherits DisposableComponent

<div class="webrtc-card webrtc-contact-card">
    <button class="webrtc-favorite-btn @(Vm.Contact.IsFavorite ? "is-favorite" : string.Empty)" @onclick="ToggleFavoriteAsync" title="@(Vm.Contact.IsFavorite ? "Remove favourite" : "Add favourite")">★</button>
    <div class="webrtc-contact-details">
        @if (_editingNickname)
        {
            <div class="webrtc-contact-name-row">
                <input class="webrtc-input webrtc-nickname-input" @bind="_nicknameEdit" @bind:event="oninput" @onkeydown="HandleNicknameKeyDownAsync" placeholder="Nickname..." />
                <button class="webrtc-icon-btn" @onclick="SaveNicknameAsync" title="Save">✓</button>
                <button class="webrtc-icon-btn" @onclick="CancelNicknameEdit" title="Cancel">✕</button>
            </div>
        }
        else
        {
            <div class="webrtc-contact-name-row">
                <strong>@(string.IsNullOrWhiteSpace(Nickname) ? Vm.Contact.Name : Nickname)</strong>
                @if (!string.IsNullOrWhiteSpace(Nickname))
                {
                    <span class="webrtc-contact-real-name">(@Vm.Contact.Name)</span>
                }
                <button class="webrtc-icon-btn webrtc-nickname-edit-btn" @onclick="StartNicknameEdit" title="@(string.IsNullOrWhiteSpace(Nickname) ? "Set nickname" : "Edit nickname")">✏</button>
            </div>
        }
        <span>@Vm.Contact.Id</span>
        @if (!string.IsNullOrWhiteSpace(Vm.ConnectionStateText))
        {
            <span class="webrtc-contact-status @GetConnectionStatusCssClass()">
                @if (Vm.IsConnecting())
                {
                    <span>Connecting<span class="webrtc-dots-animation"></span></span>
                }
                else
                {
                    @GetConnectionStatusText()
                }
            </span>
        }

        <div class="webrtc-contact-actions">
            <button class="webrtc-button" @onclick="Vm.NotifyPeerAsync">Notify</button>

            @if (!Vm.Contact.IsFavorite)
            {
                @if (Vm.IsConnecting())
                {
                    <button class="webrtc-button webrtc-button--danger" @onclick="Vm.CancelConnectAsync">Cancel</button>
                }
                else if (Vm.IsConnected())
                {
                    <button class="webrtc-button webrtc-contact-connect-button" @onclick="Vm.DisconnectAsync">Disconnect</button>
                }
                else if (Vm.CanConnect())
                {
                    <button class="webrtc-button webrtc-contact-connect-button" @onclick="Vm.ConnectAsync">Connect</button>
                }
            }

            @if (Vm.IsConnected())
            {
                @if (Vm.HasIncomingCallOffer && !Vm.IsCallActive)
                {
                    <button class="webrtc-button" @onclick="() => Vm.AcceptIncomingCallAsync(_remoteAudio)">Accept call</button>
                }
                else
                {
                    <button class="webrtc-button" @onclick="() => Vm.ToggleCallAsync(_remoteAudio)">@(Vm.IsCallActive ? "Hang up" : "Call")</button>
                }
            }
        </div>
    </div>

    <ChatPanel OnSend="Vm.SendChatMessageAsync"
               MessageSource="Vm.SubscribeToChatAsync"
               IsEnabled="Vm.ChatReady"
               IsOpen="Vm.IsConnected()"
               OnSystemMessage="text => Vm.HandleSystemMessageAsync(text, _remoteAudio)" />

    <audio class="webrtc-audio" autoplay playsinline @ref="_remoteAudio"></audio>
</div>

@code {
    [Parameter, EditorRequired]
    public ContactVm Vm { get; set; } = default!;

    [Parameter]
    public string? Nickname { get; set; }

    [Parameter, EditorRequired]
    public EventCallback ToggleFavourite { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<(string UserId, string? Nickname)> OnSetNickname { get; set; }

    private bool _editingNickname;
    private string _nicknameEdit = string.Empty;
    private ElementReference _remoteAudio;

    protected override void OnInitialized()
    {
        BoundToLifetime(Vm.Changed.Subscribe(HandleVmChanged));
    }

    private async void HandleVmChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private Task ToggleFavoriteAsync()
        => ToggleFavourite.InvokeAsync();

    private void StartNicknameEdit()
    {
        _nicknameEdit = Nickname ?? string.Empty;
        _editingNickname = true;
    }

    private void CancelNicknameEdit()
        => _editingNickname = false;

    private async Task SaveNicknameAsync()
    {
        await OnSetNickname.InvokeAsync((Vm.Contact.Id, _nicknameEdit));
        _editingNickname = false;
    }

    private async Task HandleNicknameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveNicknameAsync();
        else if (e.Key == "Escape") CancelNicknameEdit();
    }

    private string GetConnectionStatusText()
        => Vm.ConnectionState switch
        {
            RtcConnectionState.Connected => "Connected",
            RtcConnectionState.Connecting => "Connecting...",
            RtcConnectionState.Disconnected => "Disconnected",
            RtcConnectionState.Failed => "Connection failed",
            RtcConnectionState.New => "Ready to connect",
            RtcConnectionState.Closed => "Offline",
            _ => Vm.ConnectionStateText
        };

    private string GetConnectionStatusCssClass()
        => Vm.ConnectionState switch
        {
            RtcConnectionState.Connected => "is-connected",
            RtcConnectionState.Connecting => "is-connecting",
            RtcConnectionState.Failed => "is-failed",
            _ => string.Empty
        };
}
