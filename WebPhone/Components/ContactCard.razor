@using WebPhone.Services

<div class="webrtc-card webrtc-contact-card">
    @if (Model.Actions.ToggleFavorite is not null)
    {
        <button class="webrtc-favorite-btn @(Model.Contact.IsFavorite ? "is-favorite" : string.Empty)" @onclick="ToggleFavorite" title="@(Model.Contact.IsFavorite ? "Remove favourite" : "Add favourite")">★</button>
    }
    <div class="webrtc-contact-details">
        @if (_editingNickname)
        {
            <div class="webrtc-contact-name-row">
                <input class="webrtc-input webrtc-nickname-input" @bind="_nicknameEdit" @bind:event="oninput" @onkeydown="HandleNicknameKeyDownAsync" placeholder="Nickname..." />
                <button class="webrtc-icon-btn" @onclick="SaveNicknameAsync" title="Save">✓</button>
                <button class="webrtc-icon-btn" @onclick="CancelNicknameEdit" title="Cancel">✕</button>
            </div>
        }
        else
        {
            <div class="webrtc-contact-name-row">
                <strong>@(string.IsNullOrWhiteSpace(Model.Nickname) ? Model.Contact.Name : Model.Nickname)</strong>
                @if (!string.IsNullOrWhiteSpace(Model.Nickname))
                {
                    <span class="webrtc-contact-real-name">(@Model.Contact.Name)</span>
                }
                @if (Model.SetNickname is not null)
                {
                    <button class="webrtc-icon-btn webrtc-nickname-edit-btn" @onclick="StartNicknameEdit" title="@(string.IsNullOrWhiteSpace(Model.Nickname) ? "Set nickname" : "Edit nickname")">✏</button>
                }
            </div>
        }
        <span>@Model.Contact.Id</span>
        @if (!string.IsNullOrWhiteSpace(Model.ConnectionStatusText))
        {
            <span class="webrtc-contact-status @Model.ConnectionStatusCssClass">
                @if (Model.IsConnecting)
                {
                    <span>Connecting<span class="webrtc-dots-animation"></span></span>
                }
                else
                {
                    @Model.ConnectionStatusText
                }
            </span>
        }

        <div class="webrtc-contact-actions">
            @if (Model.Notify is not null)
            {
                <button class="webrtc-button" @onclick="Notify">Notify</button>
            }

            @if (!Model.Contact.IsFavorite)
            {
                @if (Model.CancelConnect is not null)
                {
                    <button class="webrtc-button webrtc-button--danger" @onclick="CancelConnect">Cancel</button>
                }
                else if (Model.Disconnect is not null)
                {
                    <button class="webrtc-button webrtc-contact-connect-button" @onclick="Disconnect">Disconnect</button>
                }
                else if (Model.Connect is not null)
                {
                    <button class="webrtc-button webrtc-contact-connect-button" @onclick="Connect">Connect</button>
                }
            }

            @if (Model.AcceptCall is not null)
            {
                <button class="webrtc-button" @onclick="AcceptCall">Accept call</button>
            }
            @if (Model.StartCall is not null)
            {
                <button class="webrtc-button" @onclick="StartCall">Call</button>
            }
            @if (Model.EndCall is not null)
            {
                <button class="webrtc-button" @onclick="EndCall">Hang up</button>
            }
            @if (Model.CancelCall is not null)
            {
                <button class="webrtc-button webrtc-button--danger" @onclick="CancelCall">Cancel call</button>
            }
        </div>
    </div>

    <ChatPanel OnSend="Model.SendMessage"
               Messages="Model.ChatMessages"
               IsEnabled="Model.ChatReady"
               IsOpen="Model.IsChatOpen" />

    <audio class="webrtc-audio" autoplay playsinline @ref="_remoteAudio"></audio>
</div>

@code {
    [Parameter, EditorRequired]
    public ContactCardModel Model { get; set; } = default!;

    private bool _editingNickname;
    private string _nicknameEdit = string.Empty;
    private ElementReference _remoteAudio;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Model.OnRemoteAudioElementReady?.Invoke(_remoteAudio);
        }
    }

    private void ToggleFavorite()
        => Model.ToggleFavorite?.Invoke();

    private void Notify()
        => Model.Notify?.Invoke();

    private void Connect()
        => Model.Connect?.Invoke();

    private void CancelConnect()
        => Model.CancelConnect?.Invoke();

    private void Disconnect()
        => Model.Disconnect?.Invoke();

    private void StartCall()
        => Model.StartCall?.Invoke();

    private void AcceptCall()
        => Model.AcceptCall?.Invoke();

    private void EndCall()
        => Model.EndCall?.Invoke();

    private void CancelCall()
        => Model.CancelCall?.Invoke();

    private void StartNicknameEdit()
    {
        _nicknameEdit = Model.Nickname ?? string.Empty;
        _editingNickname = true;
    }

    private void CancelNicknameEdit()
        => _editingNickname = false;

    private async Task SaveNicknameAsync()
    {
        Model.SetNickname?.Invoke(_nicknameEdit);
        _editingNickname = false;
    }

    private async Task HandleNicknameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveNicknameAsync();
        else if (e.Key == "Escape") CancelNicknameEdit();
    }
}
