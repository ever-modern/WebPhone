@using WebPhone.Services

@inject PeerConnector PeerConnector

@{
    var (contact, interaction, actions, onRemoteAudioElementReady) = Model;
    var (isConnected, connectionState, isConnecting, chatReady, isCallActive, isCalling, hasIncomingCall, chat) = interaction;
    var (toggleFavorite, setNickname, notify, connect, cancelConnect, disconnect, startCall, startVideoCall, acceptCall, declineCall, endCall, cancelCall, sendMessage) = actions;
}

<div class="contact-detail">
    <div class="contact-detail-header">
        @if (_editingNickname)
        {
            <div class="webrtc-contact-name-row">
                <input class="webrtc-input webrtc-nickname-input" @bind="_nicknameEdit" @bind:event="oninput" @onkeydown="HandleNicknameKeyDownAsync" placeholder="Nickname..." />
                <button class="webrtc-icon-btn" @onclick="SaveNicknameAsync" title="Save">&#10003;</button>
                <button class="webrtc-icon-btn" @onclick="CancelNicknameEdit" title="Cancel">&#10005;</button>
            </div>
        }
        else
        {
            <div class="webrtc-contact-name-row">
                <strong class="contact-detail-name">@(string.IsNullOrWhiteSpace(contact.Nickname) ? contact.Name : contact.Nickname)</strong>
                @if (!string.IsNullOrWhiteSpace(contact.Nickname))
                {
                    <span class="webrtc-contact-real-name">(@contact.Name)</span>
                }
                @if (setNickname is not null)
                {
                    <button class="webrtc-icon-btn webrtc-nickname-edit-btn" @onclick="StartNicknameEdit" title="@(string.IsNullOrWhiteSpace(contact.Nickname) ? "Set nickname" : "Edit nickname")">&#9998;</button>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(connectionState) && connectionState != "None")
        {
            <span class="webrtc-contact-status @(isConnected ? "is-connected" : isConnecting ? "is-connecting" : string.Empty)">
                @if (isConnecting)
                {
                    <span>Connecting<span class="webrtc-dots-animation"></span></span>
                }
                else
                {
                    @connectionState
                }
            </span>
        }

        <div class="contact-detail-actions">
            @if (notify is not null)
            {
                <button class="webrtc-button" @onclick="Notify">Notify</button>
            }
            @if (disconnect is not null)
            {
                <button class="webrtc-button" @onclick="Disconnect">Disconnect</button>
            }
            @if (hasIncomingCall)
            {
                @if (acceptCall is not null)
                {
                    <button class="webrtc-button" @onclick="AcceptCall">Accept call</button>
                }
                @if (declineCall is not null)
                {
                    <button class="webrtc-button webrtc-button--danger" @onclick="DeclineCall">Decline</button>
                }
            }
            @if (startCall is not null)
            {
                <button class="webrtc-button" @onclick="StartCall">Call</button>
            }
            @if (startVideoCall is not null)
            {
                <button class="webrtc-button" @onclick="StartVideoCall">&#127909; Video call</button>
            }
            @if (endCall is not null)
            {
                <button class="webrtc-button webrtc-button--danger" @onclick="EndCall">Hang up</button>
            }
            @if (cancelCall is not null)
            {
                <button class="webrtc-button webrtc-button--danger" @onclick="CancelCall">Cancel call</button>
            }
        </div>
    </div>

    <ChatPanel OnSend="sendMessage"
               Messages="chat"
               IsEnabled="chatReady" />

    <audio class="webrtc-audio" autoplay playsinline @ref="_remoteAudio"></audio>
</div>

@code {
    [Parameter, EditorRequired]
    public ContactCardModel Model { get; set; } = default!;

    private bool _editingNickname;
    private string _nicknameEdit = string.Empty;
    private ElementReference _remoteAudio;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Model.OnRemoteAudioElementReady?.Invoke(_remoteAudio);
    }

    private void ToggleFavorite()   => Model.Actions.ToggleFavorite?.Invoke();
    private void Notify()           => Model.Actions.Notify?.Invoke();
    private void Connect()          => Model.Actions.Connect?.Invoke();
    private void CancelConnect()    => Model.Actions.CancelConnect?.Invoke();
    private void Disconnect()       => Model.Actions.Disconnect?.Invoke();
    private void StartCall()        => Model.Actions.StartCall?.Invoke();
    private void StartVideoCall()   => Model.Actions.StartVideoCall?.Invoke();
    private void AcceptCall()       => Model.Actions.AcceptCall?.Invoke();
    private void DeclineCall()      => Model.Actions.DeclineCall?.Invoke();
    private void EndCall()          => Model.Actions.EndCall?.Invoke();
    private void CancelCall()       => Model.Actions.CancelCall?.Invoke();

    private void StartNicknameEdit()
    {
        _nicknameEdit = Model.Contact.Nickname ?? string.Empty;
        _editingNickname = true;
    }

    private void CancelNicknameEdit() => _editingNickname = false;

    private async Task SaveNicknameAsync()
    {
        Model.Actions.SetNickname?.Invoke(_nicknameEdit);
        _editingNickname = false;
    }

    private async Task HandleNicknameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveNicknameAsync();
        else if (e.Key == "Escape") CancelNicknameEdit();
    }
}