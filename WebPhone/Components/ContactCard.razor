@inject PeerConnectionsDispatcher PeerConnectionsDispatcher

@{
    var contact = Manager.Contact;
    var interaction = Manager.Interaction;
}

<div class="contact-detail">
    <div class="contact-detail-header">
        @if (_editingNickname)
        {
            <div class="webrtc-contact-name-row">
                <input class="webrtc-input webrtc-nickname-input" @bind="_nicknameEdit" @bind:event="oninput" @onkeydown="HandleNicknameKeyDownAsync" placeholder="Nickname..." />
                <button class="webrtc-icon-btn" @onclick="SaveNicknameAsync" title="Save">&#10003;</button>
                <button class="webrtc-icon-btn" @onclick="CancelNicknameEdit" title="Cancel">&#10005;</button>
            </div>
        }
        else
        {
            <div class="webrtc-contact-name-row">
                <strong class="contact-detail-name">@(string.IsNullOrWhiteSpace(contact.Nickname) ? contact.Name : contact.Nickname)</strong>
                @if (!string.IsNullOrWhiteSpace(contact.Nickname))
                {
                    <span class="webrtc-contact-real-name">(@contact.Name)</span>
                }
                @if (Manager.SetNickname is not null)
                {
                    <button class="webrtc-icon-btn webrtc-nickname-edit-btn" @onclick="StartNicknameEdit" title="@(string.IsNullOrWhiteSpace(contact.Nickname) ? "Set nickname" : "Edit nickname")">&#9998;</button>
                }
            </div>
        }

        @if (interaction is not InteractionState.Offline and not InteractionState.Disconnected)
        {
            var isConnecting = interaction is InteractionState.Connecting;
            var connected = interaction is InteractionState.Connected;
            <span class="webrtc-contact-status @(connected ? "is-connected" : isConnecting ? "is-connecting" : string.Empty)">
                @if (isConnecting)
                {
                    <span>Connecting<span class="webrtc-dots-animation"></span></span>
                }
                else
                {
                    @GetStatusText(interaction)
                }
            </span>
        }

        <div class="contact-detail-actions">
            <ContactSettingsSection ContactId="@contact.Id" />
            @if (interaction is InteractionState.ReceivingCall)
            {
                <button class="webrtc-button" @onclick="AcceptCall">Accept call</button>
                <button class="webrtc-button webrtc-button--danger" @onclick="DeclineCall">Decline</button>
            }
            else if (interaction is InteractionState.Connected and not InteractionState.Calling and not InteractionState.ReceivingCall and not InteractionState.OnCall)
            {
                <button class="webrtc-button" @onclick="StartCall">Call</button>
                <button class="webrtc-button" @onclick="StartVideoCall">&#127909; Video call</button>
            }
            @if (interaction is InteractionState.OnCall)
            {
                <button class="webrtc-button webrtc-button--danger" @onclick="EndCall">Hang up</button>
            }
            @if (interaction is InteractionState.Calling)
            {
                <button class="webrtc-button webrtc-button--danger" @onclick="CancelCall">Cancel call</button>
            }
        </div>
    </div>
    <audio class="webrtc-audio" autoplay playsinline @ref="_remoteAudio"></audio>
</div>

@code {
    [Parameter, EditorRequired]
    public ContactManager Manager { get; set; } = default!;

    private bool _editingNickname;
    private string _nicknameEdit = string.Empty;
    private ElementReference _remoteAudio;

    private void StartCall() => Manager.AudioCall?.Invoke();
    private void StartVideoCall() => Manager.VideoCall?.Invoke();
    private void AcceptCall() => Manager.AcceptCall?.Invoke();
    private void DeclineCall() => Manager.DeclineCall?.Invoke();
    private void EndCall() => Manager.Hangup?.Invoke();
    private void CancelCall() => Manager.StopCalling?.Invoke();

    private void StartNicknameEdit()
    {
        _nicknameEdit = Manager.Contact.Nickname ?? string.Empty;
        _editingNickname = true;
    }

    private void CancelNicknameEdit() => _editingNickname = false;

    private async Task SaveNicknameAsync()
    {
        Manager.SetNickname?.Invoke(_nicknameEdit);
        _editingNickname = false;
    }

    private async Task HandleNicknameKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveNicknameAsync();
        else if (e.Key == "Escape") CancelNicknameEdit();
    }

    static string GetStatusText(InteractionState state) => state switch
    {
        InteractionState.Connecting => "Connecting",
        InteractionState.Calling => "Calling",
        InteractionState.ReceivingCall => "Incoming call",
        InteractionState.OnCall => "On call",
        InteractionState.Connected => "Connected",
        _ => ""
    };
}
}