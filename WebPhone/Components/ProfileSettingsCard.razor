@using WebPhone.Services

@inject ProfileStore profile

<section class="webrtc-card webrtc-profile-card">
    <div class="webrtc-field webrtc-field-inline">
        @*  <label>Name</label> *@
        <input class="webrtc-input" @bind="Name" placeholder="Your name" />
        <button class="webrtc-button" @onclick="() => profile.SetUser(profile.User with { Name = Name })">
            @(profile.User.Name.Length > 0 ? "Change name" : "Register")
        </button>
    </div>
</section>

@code {
    string Name { get; set; } = "";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Name = profile.User.Name;
    }
}
