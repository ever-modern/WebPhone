@implements IDisposable

@inject ILocalStore Store
@inject IJSRuntime JS

<Drawer @ref="_drawer" Position="DrawerPosition.Left" IsDocked="IsDocked"
        Width="IsDocked ? _width : (int?)null">
    <div class="sidebar-header">
        <h2 class="sidebar-title">Contacts</h2>
    </div>

    <div class="sidebar-filter">
        <input class="webrtc-input sidebar-search"
               type="search"
               placeholder="Filter by name or nickname…"
               @bind="_filter"
               @bind:event="oninput" />
    </div>

    <div class="sidebar-list">
        @foreach (var mgr in FilteredManagers)
        {
            <ContactListItem @key="mgr.Contact.Id"
                             Manager="mgr"
                             IsSelected="SelectedId == mgr.Contact.Id"
                             OnSelect="() => HandleSelect(mgr.Contact.Id)" />
        }

        @if (!FilteredManagers.Any())
        {
            <p class="sidebar-empty">No contacts match.</p>
        }
    </div>
</Drawer>
@if (IsDocked)
{
    <div class="sidebar-resizer" @onmousedown="OnResizerMouseDown"></div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ContactManager> Managers { get; set; } = [];
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<string> OnContactSelected { get; set; }
    [Parameter] public bool IsDocked { get; set; }

    Drawer _drawer = default!;
    string _filter = string.Empty;
    int _width = 280;
    DotNetObjectReference<ContactsSidebar>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _dotNetRef = DotNetObjectReference.Create(this);
        var stored = await Store.GetAsync<int>("sidebar-width");
        if (stored > 0)
        {
            _width = stored;
            StateHasChanged();
        }
    }

    IEnumerable<ContactManager> FilteredManagers =>
        string.IsNullOrWhiteSpace(_filter)
            ? Managers
            : Managers.Where(m =>
                (m.Contact.Nickname ?? string.Empty).Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || m.Contact.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    async Task HandleSelect(string id)
    {
        if (!IsDocked) _drawer.Close();
        await OnContactSelected.InvokeAsync(id);
    }

    void OnResizerMouseDown(MouseEventArgs e)
    {
        if (_dotNetRef is null) return;
        _ = JS.InvokeVoidAsync("appInterop.startResize", e.ClientX, _width, _dotNetRef);
    }

    [JSInvokable]
    public void OnResizeDrag(int width)
    {
        _width = width;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnResizeDrop(int width)
    {
        _width = width;
        await Store.SetAsync("sidebar-width", width);
        StateHasChanged();
    }

    public void Dispose() => _dotNetRef?.Dispose();
}

