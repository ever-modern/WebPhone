@inherits LayoutComponentBase
@implements IDisposable

@inject AppStarter AppStarter
@inject ProfileStore profileStore
@inject ContactsDispatcher Dispatcher
@inject IProfile Profile
@inject IBackendClient BackendClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-container">
    @if (ready && !string.IsNullOrWhiteSpace(Profile.User.Name))
    {
        <div class="webphone-shell">
            <ContactsSidebar Managers="Dispatcher.State.Value.Contacts"
                             IsDocked="!_isMobile"
                             SelectedId="@_selectedId"
                             OnContactSelected="HandleContactSelected" />
            <main class="webphone-main">
                <div class="layout-topbar-right">
                    <button class="profile-avatar-btn" @onclick="ToggleProfileMenu" title="Profile">
                        @GetAvatarText()
                    </button>
                </div>
                @Body
            </main>
        </div>

        @if (_profileMenuOpen)
        {
            <div class="profile-menu-backdrop" @onclick="CloseProfileMenu"></div>
            <div class="profile-menu-popover" @onclick:stopPropagation="true">
                <ProfileSettingsCard />
            </div>
        }
    }
    else if (ready)
    {
        <div class="register-gate">
            <section class="register-gate-card">
                <h2>Welcome to WebPhone</h2>
                <p>Please enter your name to continue.</p>
                <input class="webrtc-input register-name-input"
                       @bind="_registerName"
                       @bind:event="oninput"
                       @onkeydown="HandleRegisterKeyDownAsync"
                       placeholder="Your name" />
                <button class="webrtc-button" @onclick="RegisterAsync" disabled="@string.IsNullOrWhiteSpace(_registerName)">Register</button>
            </section>
        </div>
    }
    @if (ready && !string.IsNullOrWhiteSpace(Profile.User.Name))
    {
        <footer class="page-footer">@($"v{BuildInfo.BuildVersion}")</footer>
    }
</div>

@* Incoming call modal (WhatsApp-style) *@
@if (IncomingCallContact is not null)
{
    <div class="call-modal-backdrop"></div>
    <div class="call-modal">
        <div class="call-modal-avatar">@IncomingCallContact.Contact.Name[0].ToString().ToUpperInvariant()</div>
        <h3 class="call-modal-name">
            @(string.IsNullOrWhiteSpace(IncomingCallContact.Contact.Nickname)
                ? IncomingCallContact.Contact.Name
                : IncomingCallContact.Contact.Nickname)
        </h3>
        <p class="call-modal-status">Incoming call…</p>
        <div class="call-modal-actions">
            <button class="call-modal-btn call-modal-btn--decline" @onclick="HandleDeclineCall">
                <span>✕</span>
                <span>Decline</span>
            </button>
            <button class="call-modal-btn call-modal-btn--accept" @onclick="HandleAcceptCall">
                <span>📞</span>
                <span>Accept</span>
            </button>
        </div>
    </div>
}

@* Active call fullscreen overlay *@
@if (ActiveCallContact is not null)
{
    <div class="active-call-overlay">
        <div class="active-call-info">
            <div class="active-call-avatar">@ActiveCallContact.Contact.Name[0].ToString().ToUpperInvariant()</div>
            <h2 class="active-call-name">
                @(string.IsNullOrWhiteSpace(ActiveCallContact.Contact.Nickname)
                    ? ActiveCallContact.Contact.Name
                    : ActiveCallContact.Contact.Nickname)
            </h2>
            <p class="active-call-status">On call</p>
        </div>
        <div class="active-call-controls">
            <button class="call-modal-btn call-modal-btn--hangup" @onclick="HandleHangup">
                <span>📞</span>
                <span>Hang up</span>
            </button>
        </div>
    </div>
}