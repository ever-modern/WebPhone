@using WebPhone.Services
@using WebPhone.Services.Background
@using WebPhone.Services.Channels
@using WebPhone.Services.Data
@inherits LayoutComponentBase
@implements IDisposable

@inject ProfileStore profileStore
@inject ContactsRepository contacts
@inject PresenceAnnouncer presenceAnnouncer
@inject NicknamesRepository nicknames
@inject AzureMessagesChannel azureMessagesChannel
@inject IncomingConnectionsHandler incomingConnectionsHandler
@inject ContactsDispatcher Dispatcher
@inject IProfile Profile
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-container">
    @if (ready)
    {
        <div class="webphone-shell">
            @if (Profile.User.Name.Length > 0)
            {
                <ContactsSidebar Cards="_contactCards"
                                 IsDocked="!_isMobile"
                                 SelectedId="@_selectedId"
                                 OnContactSelected="HandleContactSelected" />
            }
            <main class="webphone-main">
                @Body
            </main>
        </div>
    }
    <footer class="page-footer">@($"v{BuildInfo.BuildVersion}")</footer>
</div>

<VideoCallScreen />

@code {
    bool ready;
    bool _isMobile;
    DotNetObjectReference<MainLayout>? _mobileRef;
    IReadOnlyList<ContactCardModel> _contactCards = [];
    string? _selectedId;

    IDisposable? _dispatcherSub;
    IDisposable? _profileSub;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await profileStore.InitializeAsync();
        _ = azureMessagesChannel.StartAsync();
        await contacts.InitializeAsync();
        await nicknames.StartTrackingAsync();
        contacts.StartTracking();
        incomingConnectionsHandler.Start();
        await presenceAnnouncer.StartAsync();

        await Dispatcher.StartAsync();

        _dispatcherSub = Dispatcher.StateChanged.Subscribe(OnDispatcherChanged);
        _profileSub = Profile.UserChanged.Subscribe(_ => InvokeAsync(StateHasChanged));
        Nav.LocationChanged += OnLocationChanged;

        // Detect viewport before first meaningful render so there is no layout flash.
        _isMobile = await JS.InvokeAsync<bool>("appInterop.isMobile");
        _mobileRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("appInterop.startMobileWatcher", _mobileRef);

        SyncSelectedId();
        SyncCards();

        ready = true;
    }

    /// <summary>Called by the matchMedia watcher whenever the viewport crosses 767 px.</summary>
    [JSInvokable]
    public void SetMobile(bool isMobile)
    {
        if (_isMobile == isMobile) return;
        _isMobile = isMobile;
        InvokeAsync(StateHasChanged);
    }

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncSelectedId();
        InvokeAsync(StateHasChanged);
    }

    void OnDispatcherChanged()
    {
        SyncCards();
        InvokeAsync(StateHasChanged);
    }

    void SyncSelectedId()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        const string prefix = "/contact/";
        _selectedId = path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            ? Uri.UnescapeDataString(path[prefix.Length..])
            : null;
    }

    void SyncCards()
    {
        _contactCards = Dispatcher.State.Contacts
            .Select(s => new ContactCardModel(
                Contact: s.Contact,
                InteractionState: s.InteractionState,
                Actions: s.AvailableActions,
                OnRemoteAudioElementReady: null))
            .ToList();
    }

    void HandleContactSelected(string id) =>
        Nav.NavigateTo($"/contact/{Uri.EscapeDataString(id)}");

    public void Dispose()
    {
        _mobileRef?.Dispose();
        _dispatcherSub?.Dispose();
        _profileSub?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
        Dispatcher.Dispose();
    }
}
